# Copie para .env.local (nunca commite o arquivo real).
# Em producao, defina cada variavel no painel da Vercel
# (Settings > Environment Variables), NAO em arquivo.

# --- ZuckPay ---
# Painel ZuckPay > Desenvolvedores > Credenciais API.
ZUCKPAY_CLIENT_ID=
ZUCKPAY_CLIENT_SECRET=

# Opcional, recomendado: card "Webhook Secret" em
# https://www.zuckpay.com.br/conta/keys.php (diferente do client_secret).
# Com ele definido, postbacks sem assinatura valida sao recusados.
ZUCKPAY_WEBHOOK_SECRET=

# --- Meta (Facebook) ---
# Dispara o Purchase server-side, a partir do webhook. Sem isso, a venda por
# PIX nao e contabilizada quando o comprador paga no banco e nao volta pro site.
# O ID e o mesmo que voce cola em window.META_PIXEL_ID no public/index.html.
# Gerenciador de Eventos > Configuracoes > Conversions API > Gerar token.
META_PIXEL_ID=
META_CAPI_TOKEN=

# Opcional: codigo da aba "Eventos de teste", para ver os eventos em tempo real.
META_TEST_EVENT_CODE=

# Protege /api/diagnostico. Sem esta variavel o endereco responde 404.
# Com ela: /api/diagnostico?token=<valor> diz se as credenciais da ZuckPay
# estao presentes e se ela as aceita — sem nunca mostrar o valor delas.
DIAGNOSTICO_SECRET=
